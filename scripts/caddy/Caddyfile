{
	# Use Caddy's internal CA for self-signed TLS on LAN
}

https://{$HUB_HOST} {
	# RSA-2048 leaf certificates: stock Windows PowerShell 5.1 clients do not
	# accept Caddy's default ECDSA keys (see AGENTS.md).
	tls internal {
		key_type rsa2048
	}

	# Hub API routes
	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}

	# WebSocket routes (agent + terminal)
	handle /ws/* {
		reverse_proxy 127.0.0.1:4000
	}

	# Health check
	handle /health {
		reverse_proxy 127.0.0.1:4000
	}

	# Install script
	handle /install.sh {
		reverse_proxy 127.0.0.1:4000
	}
	handle /install.ps1 {
		reverse_proxy 127.0.0.1:4000
	}

	# Agent binary download
	handle /download/* {
		reverse_proxy 127.0.0.1:4000
	}

	# Dashboard (everything else)
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

http://{$HUB_HOST} {
	redir https://{$HUB_HOST}{uri} permanent
}

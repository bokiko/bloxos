[Unit]
Description=BloxOS Agent
After=network.target bloxos-hub.service
Wants=bloxos-hub.service

[Service]
Type=simple
User=bokiko
WorkingDirectory=/home/bokiko/bloxos/agent
Environment="BLOXOS_HUB=ws://localhost:4000"
Environment="BLOXOS_TOKEN="
ExecStart=/home/bokiko/bloxos/agent/bloxos-agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
